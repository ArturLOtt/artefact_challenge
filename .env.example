# ==========================================
# Empório da Música - Configuration Variables
# ==========================================

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Provider Configuration
# Compatible with OpenAI, Google Gemini (via OpenAI compatibility endpoint), Groq, Ollama, etc.
LLM_API_KEY=your_openai_or_gemini_api_key_here
LLM_MODEL=gpt-4o-mini
# To use OpenAI: https://api.openai.com/v1
# To use Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# To use Local Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# WhatsApp Meta Cloud API Configuration
# Get these in your Meta for Developers dashboard -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_meta_system_user_or_temporary_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_secret_verify_token_here
WHATSAPP_API_VERSION=v20.0

# Store Metadata
COMPANY_NAME="Empório da Música"
COMPANY_PHONE="+55 (11) 98765-4321"
HUMAN_SUPPORT_PHONE="+55 (11) 91234-5678"
